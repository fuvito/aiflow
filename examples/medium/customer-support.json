{
  "version": "1.0",
  "id": "medium-customer-support",
  "name": "Customer Support Agent",
  "description": "Classifies support requests, searches the knowledge base, retrieves customer info, and routes complex cases to a human reviewer before generating a response.",
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "name": "Start",
      "position": { "x": 350, "y": 80 },
      "config": {}
    },
    {
      "id": "classify-request",
      "type": "LLM",
      "name": "Classify Request",
      "position": { "x": 350, "y": 240 },
      "config": {
        "model": "gpt-4o-mini",
        "prompt": "Classify the customer support request into one of: billing, technical, account, or general. Also determine complexity: simple (can be resolved automatically) or complex (requires human review). Return JSON: {\"category\": string, \"complexity\": \"simple\" | \"complex\"}",
        "temperature": 0
      }
    },
    {
      "id": "knowledge-search",
      "type": "RAG",
      "name": "Knowledge Search",
      "position": { "x": 350, "y": 400 },
      "config": {
        "knowledgeBase": "support-documents",
        "topK": 5,
        "similarityThreshold": 0.7
      }
    },
    {
      "id": "customer-api",
      "type": "API",
      "name": "Customer API",
      "position": { "x": 350, "y": 560 },
      "config": {
        "method": "GET",
        "url": "https://api.internal/customers/{{input.customerId}}",
        "headers": { "Authorization": "Bearer env:CUSTOMER_API_TOKEN" }
      }
    },
    {
      "id": "decision",
      "type": "CONDITION",
      "name": "Route Decision",
      "position": { "x": 350, "y": 720 },
      "config": {
        "expression": "classify_request.complexity == \"complex\""
      }
    },
    {
      "id": "human-review",
      "type": "HITL",
      "name": "Human Review",
      "position": { "x": 620, "y": 880 },
      "config": {
        "instructions": "Review the customer request and the AI-retrieved context. Provide a resolution or escalate to a specialist. Respond with a clear action and the final message to send the customer."
      }
    },
    {
      "id": "generate-response",
      "type": "LLM",
      "name": "Generate Response",
      "position": { "x": 350, "y": 1040 },
      "config": {
        "model": "gpt-4o-mini",
        "prompt": "Using the customer information, knowledge base results, and resolution (from human review if applicable), write a helpful, professional response to the customer's support request.",
        "temperature": 0.3
      }
    },
    {
      "id": "end",
      "type": "END",
      "name": "End",
      "position": { "x": 350, "y": 1200 },
      "config": {}
    }
  ],
  "edges": [
    { "source": "start",             "target": "classify-request" },
    { "source": "classify-request",  "target": "knowledge-search" },
    { "source": "knowledge-search",  "target": "customer-api" },
    { "source": "customer-api",      "target": "decision" },
    { "source": "decision",          "target": "generate-response", "condition": "simple" },
    { "source": "decision",          "target": "human-review",      "condition": "complex" },
    { "source": "human-review",      "target": "generate-response" },
    { "source": "generate-response", "target": "end" }
  ],
  "metadata": {
    "difficulty": "medium",
    "industry": "Customer Service",
    "tags": ["customer-support", "rag", "hitl", "routing"],
    "sample_input": {
      "customerId": "cust_789",
      "message": "I was charged twice for my subscription this month. Can you help?"
    }
  }
}
