{
  "version": "1.0",
  "id": "easy-email-auto-reply",
  "name": "Email Auto-Reply",
  "description": "Reads an incoming support email and generates a professional reply using an LLM.",
  "nodes": [
    {
      "id": "start",
      "type": "START",
      "name": "Start",
      "position": { "x": 350, "y": 80 },
      "config": {}
    },
    {
      "id": "draft-reply",
      "type": "LLM",
      "name": "Draft Reply",
