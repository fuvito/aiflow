      "config": {
        "model": "gpt-4o-mini",
        "prompt": "You are a customer support agent. Read the incoming email and write a helpful, professional reply. Be concise and friendly. Input: {{input}}",
        "temperature": 0.4
      }
    },
    {
      "id": "end",
      "type": "END",
      "name": "End",
      "position": { "x": 350, "y": 400 },
      "config": {}
    }
  ],
  "edges": [
    { "source": "start",       "target": "draft-reply" },
    { "source": "draft-reply", "target": "end" }
  ],
  "metadata": {
    "difficulty": "easy",
    "industry": "Customer Service",
    "tags": ["email", "llm", "auto-reply"]
  }
}
