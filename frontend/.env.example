# URL of the AiFlow backend API.
VITE_API_BASE_URL=http://localhost:8000

# Supabase — anon key is safe to expose to the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile — site key (safe to expose to the browser)
# Get keys at: https://dash.cloudflare.com/ → Turnstile
# Test site key (always passes): 1x00000000000000000000AA
# Leave empty to disable Turnstile (widget won't render in dev)
VITE_TURNSTILE_SITE_KEY=
