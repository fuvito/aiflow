## ── LLM Provider ───────────────────────────────────────────────────────────
## Pick one and fill in the values.

## OpenAI
LLM_BASE_URL=
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

## LM Studio (local)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=google/gemma-4-e4b

## ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]

## ── Supabase (server-side only — NEVER expose to the browser) ───────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

## ── Demo Usage Limits ───────────────────────────────────────────────────────
DEMO_MAX_EXECUTIONS_PER_DAY=10
DEMO_MAX_LLM_REQUESTS_PER_DAY=20

## Approved users (0 = unlimited)
APPROVED_MAX_EXECUTIONS_PER_DAY=0
APPROVED_MAX_LLM_REQUESTS_PER_DAY=0

## ── Bootstrap Admin ─────────────────────────────────────────────────────────
## On startup, this email is automatically promoted to approved admin.
## Set once for a fresh deployment; safe to leave set permanently (idempotent).
ADMIN_EMAIL=

## ── Cloudflare Turnstile (leave empty to skip verification in dev) ───────────
## Get keys at: https://dash.cloudflare.com/ → Turnstile
## Test secret (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
